# Local build output and captures (never commit these)
build/
captures/
capture/dumps/
*.pgm

# Third-party prior art, cloned on demand (see README)
reference/

# HP/Synaptics proprietary reference artifacts -- research only, never committed
# (see docs/hp-artifacts.md). These normally live outside the repo; this is a
