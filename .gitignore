sp84530*
validity-sensor
validity-sensor-unlocked
vcsFPService
HPUsbVFS*.img
hp-patches/
# the proprietary path fetches HP's tool into a staging dir at setup time
proprietary/validity-sensor*

# Offline harness build output
tools/standalone/*.o
tools/standalone/replay_assembly
tools/standalone/driver_crypto_selftest

# Local debug logs
journallog*.txt

# Local virtualenvs, if any
.venv/
__pycache__/
*.pyc
